# ---- Data source ----
# espn: real NBA and NCAA Division I games, live scores, DraftKings lines, box scores, injuries
#       and rosters from ESPN's public API (no key). demo: the committed synthetic dataset.
DATA_SOURCE=espn
ESPN_SEASONS_NBA=3
ESPN_SEASONS_CBB=2
ESPN_POLL_SECONDS=60

# ---- Optional keyed providers (player prop lines, more sportsbooks) ----
BALLDONTLIE_API_KEY=
ODDS_API_KEY=
SPORTSDATAIO_API_KEY=
ODDS_API_REGIONS=us
ODDS_API_BOOKMAKERS=draftkings,fanduel,betmgm,williamhill_us

# ---- COURTSIDE AI (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ---- Assets: with DATA_SOURCE=espn team logos and player headshots come from ESPN's CDN.
# Base URL of a licensed logo CDN ({slug}.svg), used when no logo asset is registered.
LICENSED_LOGO_BASE_URL=

# ---- Runtime ----
LIVE_POLL_SECONDS=20
ODDS_POLL_SECONDS=300
MONTE_CARLO_SIMS=10000
RANDOM_SEED=20261118
# DATA_SOURCE=demo: load the committed synthetic dataset (backend/data/demo_snapshot) into an empty database.
USE_DEMO_SNAPSHOT=true
# Protects mutating admin endpoints (retrain, tune, refresh, asset registry) when set.
ADMIN_TOKEN=
POSTGRES_PASSWORD=courtside
# Optional: MLflow experiment tracking
MLFLOW_TRACKING_URI=
